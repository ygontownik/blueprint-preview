{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ygontownik.dev/blueprint-state.schema.json",
  "title": "AI Operating Model Blueprint — Canonical State",
  "description": "Single source of truth hydrating every dashboard surface, briefing, and export. Compiled from source markdown + YAML by blueprint-refresh.py. Mirrors the dashboards/cos-pipeline pattern: one canonical compile, many surfaces.",
  "type": "object",
  "required": ["meta", "org_parameters", "operating_layers", "capability_planes", "sections", "roadmap", "leverage_build_matrix", "risks", "open_questions", "actions"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "generated_at", "agency_id", "classification", "compile_source"],
      "properties": {
        "version": {"type": "string", "description": "Semver of the blueprint state"},
        "generated_at": {"type": "string", "format": "date-time"},
        "agency_id": {"type": "string", "description": "Tenant identifier"},
        "classification": {"enum": ["U", "CUI", "S", "TS"], "description": "Highest classification of any field"},
        "compile_source": {"type": "string", "description": "Git ref or path of source materials compiled"},
        "served_html_contract_required_setters": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Window-global setters the served HTML must carry (HI1 analog). Extended contract additionally requires: __EXTERNAL_INTEL__, __PEER_LEARNINGS__, __BEST_PRACTICES__, __SYNTHESIS__, __ROLE_TIER__."
        }
      }
    },
    "org_parameters": {
      "type": "object",
      "required": ["total_fte", "direct_reports", "active_programs", "programs_to_stand_up"],
      "properties": {
        "total_fte": {"type": "integer"},
        "direct_reports": {"type": "integer"},
        "active_programs": {"type": "integer"},
        "programs_to_stand_up": {"type": "integer"},
        "program_fte": {"type": "integer"},
        "span_fte": {"type": "integer"},
        "primary_work": {"type": "string"},
        "change_mechanism": {"type": "string"},
        "mission_heterogeneity": {"enum": ["low", "medium", "high"]}
      }
    },
    "operating_layers": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "name", "purpose", "primary_user", "claude_code_surface", "owner", "status"],
        "properties": {
          "id": {"enum": ["L1", "L2", "L3", "L4", "L5", "L6"]},
          "name": {"type": "string"},
          "purpose": {"type": "string"},
          "primary_user": {"type": "string"},
          "claude_code_surface": {"type": "string"},
          "owner": {"type": "string", "description": "Must resolve in owner_whitelist"},
          "status": {"enum": ["planned", "in_design", "build", "pilot", "live", "mature"]},
          "workflows": {"type": "array", "items": {"type": "string"}},
          "integrations_required": {"type": "array", "items": {"type": "string"}},
          "leveraged_from_existing": {"type": "array", "items": {"type": "string"}},
          "net_new_components": {"type": "array", "items": {"type": "string"}},
          "kpis": {"type": "array", "items": {"$ref": "#/$defs/kpi"}}
        }
      }
    },
    "capability_planes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "name", "purpose", "reference_pattern", "owner", "status"],
        "properties": {
          "id": {"enum": ["P1", "P2", "P3", "P4", "P5", "P6", "P7"]},
          "name": {"type": "string"},
          "purpose": {"type": "string"},
          "reference_pattern": {"type": "string", "description": "The reference-implementation pattern this plane inherits"},
          "owner": {"type": "string"},
          "status": {"enum": ["planned", "in_design", "build", "pilot", "live", "mature"]},
          "shared_infrastructure": {"type": "string"},
          "consumed_by_layers": {"type": "array", "items": {"enum": ["L1", "L2", "L3", "L4", "L5", "L6"]}},
          "contributes_to_layers": {"type": "array", "items": {"enum": ["L1", "L2", "L3", "L4", "L5", "L6"]}},
          "kpis": {"type": "array", "items": {"$ref": "#/$defs/kpi"}}
        }
      }
    },
    "layer_plane_matrix": {
      "type": "array",
      "description": "6 layers × 7 planes = 42 cells. Each cell describes what flows between layer and plane.",
      "items": {
        "type": "object",
        "required": ["layer_id", "plane_id", "data_in", "data_out", "shared_state"],
        "properties": {
          "layer_id": {"enum": ["L1", "L2", "L3", "L4", "L5", "L6"]},
          "plane_id": {"enum": ["P1", "P2", "P3", "P4", "P5", "P6", "P7"]},
          "data_in": {"type": "string"},
          "data_out": {"type": "string"},
          "shared_state": {"type": "string"},
          "shared_registry": {"type": "string"}
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "required": ["id", "title", "core_recommendation", "open_questions", "dependencies", "success_metric"],
        "properties": {
          "id": {"type": "integer", "minimum": 1, "maximum": 18},
          "title": {"type": "string"},
          "core_recommendation": {"type": "string", "description": "1-2 paragraph bottom line"},
          "design_detail": {"type": "string", "description": "Markdown body"},
          "leverage_build_calls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["item", "decision"],
              "properties": {
                "item": {"type": "string"},
                "decision": {"enum": ["leverage", "build", "procure", "hybrid"]},
                "reference_pattern_inherited": {"type": "string"},
                "capability_plane_consumed": {"type": "string"},
                "why": {"type": "string"}
              }
            }
          },
          "open_questions": {"type": "array", "items": {"$ref": "#/$defs/open_question_ref"}},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "success_metric": {"type": "string"},
          "owner": {"type": "string"},
          "linked_actions": {"type": "array", "items": {"type": "string"}, "description": "Action IDs from actions[]"}
        }
      }
    },
    "roadmap": {
      "type": "object",
      "required": ["phases"],
      "properties": {
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "start_day", "end_day", "deliverables", "gate", "owner"],
            "properties": {
              "id": {"type": "string"},
              "label": {"type": "string"},
              "start_day": {"type": "integer"},
              "end_day": {"type": "integer"},
              "deliverables": {"type": "array", "items": {"type": "string"}},
              "gate": {"type": "string", "description": "Go/no-go criteria for proceeding"},
              "owner": {"type": "string"},
              "depends_on": {"type": "array", "items": {"type": "string"}, "description": "Phase IDs"},
              "success_metric": {"type": "string"}
            }
          }
        },
        "critical_path_mermaid": {"type": "string", "description": "Mermaid sequence/graph source"}
      }
    },
    "leverage_build_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability", "recommendation"],
        "properties": {
          "capability": {"type": "string"},
          "native_to_claude_code": {"type": "boolean"},
          "existing_agency_system": {"type": "string"},
          "commercial_option": {"type": "string"},
          "recommendation": {"enum": ["leverage", "build", "procure", "hybrid"]},
          "why": {"type": "string"},
          "owner": {"type": "string"},
          "section_refs": {"type": "array", "items": {"type": "integer"}}
        }
      }
    },
    "pattern_inheritance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern_id", "pattern_name", "inherited_by_sections"],
        "properties": {
          "pattern_id": {"type": "string", "description": "e.g., G2, AA1, EP1, HI1, U2, Y2"},
          "pattern_name": {"type": "string"},
          "reference_source": {"type": "string", "description": "Where in cos-pipeline / dashboards / config this lives"},
          "inherited_by_sections": {"type": "array", "items": {"type": "integer"}},
          "inherited_by_planes": {"type": "array", "items": {"type": "string"}},
          "extension_notes": {"type": "string", "description": "What's new at 400-person federal scale"}
        }
      }
    },
    "knowledge_graph_seed": {
      "type": "object",
      "description": "P7 sample data shown on the Knowledge Graph surface",
      "properties": {
        "stakeholders": {"type": "array", "items": {"$ref": "#/$defs/graph_node"}},
        "programs": {"type": "array", "items": {"$ref": "#/$defs/graph_node"}},
        "authorities": {"type": "array", "items": {"$ref": "#/$defs/graph_node"}},
        "commitments": {"type": "array", "items": {"$ref": "#/$defs/graph_node"}},
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "target", "relationship"],
            "properties": {
              "source": {"type": "string"},
              "target": {"type": "string"},
              "relationship": {"type": "string"}
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "risk", "probability", "impact", "mitigation_owner", "mitigation_action"],
        "properties": {
          "id": {"type": "string"},
          "risk": {"type": "string"},
          "probability": {"enum": ["low", "medium", "high"]},
          "impact": {"enum": ["low", "medium", "high"]},
          "mitigation_owner": {"type": "string"},
          "mitigation_action": {"type": "string"},
          "residual_risk": {"enum": ["low", "medium", "high"]},
          "section_refs": {"type": "array", "items": {"type": "integer"}}
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "owner", "status"],
        "properties": {
          "id": {"type": "string"},
          "question": {"type": "string"},
          "owner": {"type": "string"},
          "status": {"enum": ["open", "in_progress", "resolved"]},
          "answer": {"type": "string"},
          "due_date": {"type": "string", "format": "date"},
          "section_refs": {"type": "array", "items": {"type": "integer"}}
        }
      }
    },
    "actions": {
      "type": "array",
      "description": "Universal action flow (P2 analog). Mirrors actions_mirror_state.json shape from dashboards.",
      "items": {
        "type": "object",
        "required": ["action_id", "verb_first_action", "owner", "due_date", "dashboard_routing", "status"],
        "properties": {
          "action_id": {"type": "string", "description": "Stable ID, 8-hex pattern (AA1 analog)"},
          "verb_first_action": {"type": "string"},
          "owner": {"type": "string", "description": "Must resolve in owner_whitelist (G3 analog)"},
          "due_date": {"type": "string", "format": "date", "description": "Absolute YYYY-MM-DD (AB1 analog)"},
          "parties": {"type": "array", "items": {"type": "string"}},
          "context": {"type": "string"},
          "priority": {"enum": ["high", "medium", "low"]},
          "source_artifact_id": {"type": "string"},
          "dashboard_routing": {
            "type": "object",
            "required": ["layer", "surfaces"],
            "properties": {
              "layer": {"enum": ["L1", "L2", "L3", "L4", "L5", "L6"]},
              "surfaces": {"type": "array", "items": {"type": "string"}},
              "plane": {"type": "string"}
            }
          },
          "status": {"enum": ["open", "in_progress", "blocked", "past_due_unclassified", "resolved", "superseded", "rolled_forward"]},
          "section_refs": {"type": "array", "items": {"type": "integer"}}
        }
      }
    },
    "costs": {
      "type": "object",
      "properties": {
        "by_phase": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "phase_id": {"type": "string"},
              "fte_cost_usd": {"type": "number"},
              "tech_cost_usd": {"type": "number"},
              "contractor_cost_usd": {"type": "number"},
              "training_cost_usd": {"type": "number"},
              "ato_cost_usd": {"type": "number"},
              "total_usd": {"type": "number"}
            }
          }
        },
        "headcount_by_role_by_phase": {"type": "object"}
      }
    },
    "kpis_org_wide": {
      "type": "array",
      "items": {"$ref": "#/$defs/kpi"}
    },
    "owner_whitelist": {
      "type": "array",
      "description": "Mirrors firm_context.yaml owner_whitelist. All owner fields anywhere in the state must resolve here.",
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "properties": {
          "name": {"type": "string"},
          "role": {"type": "string"},
          "span": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "definition"],
        "properties": {
          "term": {"type": "string"},
          "definition": {"type": "string"},
          "scope": {"enum": ["federal", "agency", "program"]}
        }
      }
    },
    "tombstones": {
      "type": "array",
      "description": "Dismissed actions / archived items (AA1 analog). Stable IDs persist across compiles.",
      "items": {
        "type": "object",
        "required": ["id", "type", "dismissed_at"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["action", "open_question", "risk", "leverage_build_row", "peer_learning", "external_intel", "best_practice"]},
          "dismissed_at": {"type": "string", "format": "date-time"},
          "reason": {"type": "string"}
        }
      }
    },
    "synthesis_layers": {
      "type": "object",
      "description": "Hierarchical synthesis outputs — each level sees a different resolution of the same underlying data. Generated by dedicated model passes: Haiku (program), Sonnet (DR), Opus (group head).",
      "properties": {
        "program": {
          "type": "array",
          "description": "Per-program morning synthesis (Haiku, 6:30am). Full operational detail + peer learning cards + matched external intel.",
          "items": {
            "type": "object",
            "required": ["program_id", "generated_at", "model", "items"],
            "properties": {
              "program_id": {"type": "string"},
              "generated_at": {"type": "string", "format": "date-time"},
              "model": {"type": "string", "enum": ["haiku", "sonnet", "opus"]},
              "items": {"type": "array", "items": {"$ref": "#/$defs/synthesis_item"}}
            }
          }
        },
        "dr": {
          "type": "array",
          "description": "Per-DR morning synthesis (Sonnet, 7:15am). Exception view across their program span — only programs needing DR attention, cross-program resource conflicts, commitments at risk.",
          "items": {
            "type": "object",
            "required": ["dr_id", "generated_at", "model", "items"],
            "properties": {
              "dr_id": {"type": "string"},
              "generated_at": {"type": "string", "format": "date-time"},
              "model": {"type": "string", "enum": ["haiku", "sonnet", "opus"]},
              "programs_in_span": {"type": "array", "items": {"type": "string"}},
              "items": {"type": "array", "items": {"$ref": "#/$defs/synthesis_item"}}
            }
          }
        },
        "group_head": {
          "type": "object",
          "description": "Group-head morning brief (Opus, 7:45am). 3–5 signals only — decisions, cross-cutting risks, portfolio exceptions, external intel digest. Never shows individual action items.",
          "properties": {
            "generated_at": {"type": "string", "format": "date-time"},
            "model": {"type": "string", "enum": ["haiku", "sonnet", "opus"]},
            "signals": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/synthesis_item"}},
            "decisions_pending": {"type": "integer"},
            "programs_flagged": {"type": "integer"},
            "external_intel_count": {"type": "integer"}
          }
        }
      }
    },
    "external_intelligence": {
      "type": "array",
      "description": "P3 External Intelligence Ingestion. Items ingested from the federal intelligence feed taxonomy, triaged for relevance, annotated with so-what per program.",
      "items": {
        "type": "object",
        "required": ["id", "source_tier", "title", "published_date", "relevance_score", "programs_matched"],
        "properties": {
          "id": {"type": "string"},
          "source_tier": {"enum": ["T1_regulatory", "T2_agency", "T3_market", "T4_congressional"]},
          "source_name": {"type": "string", "description": "e.g. Federal Register, OMB, GAO, CRS, House E&C"},
          "title": {"type": "string"},
          "published_date": {"type": "string", "format": "date"},
          "ingested_at": {"type": "string", "format": "date-time"},
          "relevance_score": {"type": "number", "minimum": 0, "maximum": 10},
          "actionability_score": {"type": "number", "minimum": 0, "maximum": 10},
          "programs_matched": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["program_id", "relevance_reason", "so_what"],
              "properties": {
                "program_id": {"type": "string"},
                "relevance_reason": {"type": "string"},
                "so_what": {"type": "string", "description": "One-paragraph annotation: what this means specifically for this program"},
                "suggested_action": {"type": "string"}
              }
            }
          },
          "stakeholders_mentioned": {"type": "array", "items": {"type": "string"}},
          "action_generated": {"type": "string", "description": "action_id if an action was routed via P2"},
          "routing_decision": {"enum": ["action_generated", "context_only", "archived"]}
        }
      }
    },
    "peer_learnings": {
      "type": "array",
      "description": "Cross-program learning cards generated by the situational pattern-matching engine. Surfaced when a program enters a situation type that similar programs have faced before.",
      "items": {
        "type": "object",
        "required": ["id", "target_program_id", "source_program_id", "situation_type", "learning", "status"],
        "properties": {
          "id": {"type": "string"},
          "target_program_id": {"type": "string", "description": "Program this learning is surfaced to"},
          "source_program_id": {"type": "string", "description": "Program the learning was extracted from"},
          "situation_type": {
            "enum": [
              "commitment_slipping",
              "procurement_delay",
              "stakeholder_conflict",
              "policy_gap",
              "capacity_crunch",
              "launch_delay",
              "design_divergence"
            ]
          },
          "learning": {"type": "string", "description": "Specific, citable action the source program took"},
          "outcome": {"type": "string", "description": "What happened as a result"},
          "source_log_ref": {"type": "string", "description": "Source program log entry date/ID for traceability"},
          "similarity_basis": {"type": "string", "description": "Why these programs are considered structurally similar"},
          "status": {"enum": ["surfaced", "applied", "dismissed", "promoted_to_best_practice"]},
          "surfaced_at": {"type": "string", "format": "date-time"},
          "best_practice_id": {"type": "string", "description": "BP-XXX ID if promoted"}
        }
      }
    },
    "best_practices": {
      "type": "array",
      "description": "Promoted practice library. Best practices extracted from top-performing programs, reviewed by program manager and confirmed by Head of AI. Each entry has a stable BP-XXX ID.",
      "items": {
        "type": "object",
        "required": ["id", "title", "source_program_id", "practice_description", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^BP-[0-9]{3}$", "description": "Stable ID e.g. BP-001"},
          "title": {"type": "string"},
          "source_program_id": {"type": "string"},
          "practice_description": {"type": "string", "description": "Specific, citable description of what the program did"},
          "outcome_evidence": {"type": "string"},
          "applicable_program_types": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["proposed", "under_review", "confirmed", "in_program_kit", "retired"]},
          "confirmed_by": {"type": "string"},
          "confirmed_at": {"type": "string", "format": "date"},
          "adopted_by_programs": {"type": "array", "items": {"type": "string"}},
          "section_refs": {"type": "array", "items": {"type": "integer"}}
        }
      }
    },
    "role_visibility": {
      "type": "object",
      "description": "Three-layer tiered visibility configuration. Enforced at compile time (separate state files per tier), dashboard route guard (PIV/CAC role → route), and system prompt (CLAUDE.md per-tier prohibition).",
      "properties": {
        "compile_targets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tier", "output_file", "included_fields"],
            "properties": {
              "tier": {"enum": ["staff", "program_manager", "dr", "group_head", "admin"]},
              "output_file": {"type": "string", "description": "e.g. state-staff.json"},
              "included_fields": {"type": "array", "items": {"type": "string"}},
              "excluded_fields": {"type": "array", "items": {"type": "string"}},
              "synthesis_layer": {"type": "string", "description": "Which synthesis_layers key to use"},
              "program_scope": {"enum": ["own_only", "dr_span", "full_portfolio"]}
            }
          }
        },
        "route_guards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "route": {"type": "string"},
              "minimum_tier": {"enum": ["staff", "program_manager", "dr", "group_head", "admin"]},
              "sso_role_attribute": {"type": "string"}
            }
          }
        },
        "system_prompt_constraints": {
          "type": "object",
          "description": "What each tier's CLAUDE.md instructs Claude NOT to answer",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "program_similarity_map": {
      "type": "array",
      "description": "Structural similarity scores between programs. Generated by Opus on first onboarding and re-run quarterly. Drives cross-program learning propagation.",
      "items": {
        "type": "object",
        "required": ["program_id", "similar_programs"],
        "properties": {
          "program_id": {"type": "string"},
          "program_type": {"type": "string"},
          "phase": {"enum": ["pre_launch", "active", "mature", "wind_down"]},
          "primary_agencies": {"type": "array", "items": {"type": "string"}},
          "work_mode": {"type": "string"},
          "risk_categories": {"type": "array", "items": {"type": "string"}},
          "similar_programs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "program_id": {"type": "string"},
                "similarity_score": {"type": "number", "minimum": 0, "maximum": 1},
                "similarity_basis": {"type": "string"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "kpi": {
      "type": "object",
      "required": ["name", "target"],
      "properties": {
        "name": {"type": "string"},
        "target": {"type": "string"},
        "current": {"type": "string"},
        "trend": {"enum": ["up", "down", "flat", "unknown"]},
        "measurement_cadence": {"type": "string"}
      }
    },
    "open_question_ref": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "question": {"type": "string"}
      }
    },
    "graph_node": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": {"type": "string"},
        "label": {"type": "string"},
        "type": {"type": "string"},
        "attributes": {"type": "object"}
      }
    },
    "synthesis_item": {
      "type": "object",
      "required": ["type", "title", "body"],
      "properties": {
        "type": {
          "enum": [
            "decision_required",
            "risk_escalated",
            "commitment_at_risk",
            "program_exception",
            "best_practice_alert",
            "peer_learning",
            "external_intel",
            "cross_program_pattern"
          ]
        },
        "title": {"type": "string"},
        "body": {"type": "string"},
        "program_ids": {"type": "array", "items": {"type": "string"}},
        "action_id": {"type": "string"},
        "urgency": {"enum": ["immediate", "this_week", "monitor"]},
        "click_through": {"type": "string", "description": "Route to drill into"}
      }
    },
    "signal_quality": {
      "type": "object",
      "description": "Four-dimension triage scores assigned at capture before item enters canonical state. Items below threshold are parked in low-signal archive.",
      "properties": {
        "relevance_score": {"type": "number", "minimum": 0, "maximum": 10},
        "actionability_score": {"type": "number", "minimum": 0, "maximum": 10},
        "novelty_score": {"type": "number", "minimum": 0, "maximum": 10},
        "source_credibility": {"type": "number", "minimum": 0, "maximum": 10},
        "composite_score": {"type": "number", "minimum": 0, "maximum": 10},
        "routing_decision": {"enum": ["action_flow", "context_enrichment", "external_staging", "archived"]},
        "triage_model": {"type": "string"}
      }
    }
  }
}
